@model ResearchAnalytics.Models.ReportCustomizationOptions

@{
    ViewData["Title"] = "Customize Report";
}

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="page-title">Customize Report</h1>
            <p class="page-subtitle">
                Select the columns and structure you want to include in your Excel report.
            </p>
        </div>

        <a asp-action="CombinedReportView"
           asp-route-ids="@string.Join(",", Model.SelectedAuthorIds)"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>

    <form asp-action="ExportCustomCombinedReportToExcel" method="post">

        @foreach (var id in Model.SelectedAuthorIds)
        {
            <input type="hidden" name="SelectedAuthorIds" value="@id" />
        }

        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="ra-card h-100">
                    <h4 class="mb-3">Author Metrics</h4>

                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IncludeAuthorName" />
                        <label class="form-check-label" asp-for="IncludeAuthorName">Author name</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IncludeSource" />
                        <label class="form-check-label" asp-for="IncludeSource">Source</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IncludePaperCount" />
                        <label class="form-check-label" asp-for="IncludePaperCount">Paper count</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IncludeAuthorCitations" />
                        <label class="form-check-label" asp-for="IncludeAuthorCitations">Author citations</label>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="ra-card h-100">
                    <h4 class="mb-3">Publication Data</h4>

                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IncludeTitle" />
                        <label class="form-check-label" asp-for="IncludeTitle">Title</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IncludeYear" />
                        <label class="form-check-label" asp-for="IncludeYear">Year</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IncludeCitations" />
                        <label class="form-check-label" asp-for="IncludeCitations">Citations</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IncludeExternalPaperId" />
                        <label class="form-check-label" asp-for="IncludeExternalPaperId">External paper ID</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IncludeUrl" />
                        <label class="form-check-label" asp-for="IncludeUrl">URL</label>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="ra-card h-100">
                    <h4 class="mb-3">Report Structure</h4>

                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="SeparateBySource" />
                        <label class="form-check-label" asp-for="SeparateBySource">
                            Separate publications by source
                        </label>
                    </div>

                    <p class="text-muted mt-3 mb-0">
                        If enabled, the Excel report will create separate sheets for Semantic Scholar and OpenAlex.
                    </p>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success">
            <i class="bi bi-sliders"></i>
            Export Excel
        </button>
    </form>
</div>