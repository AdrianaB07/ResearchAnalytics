@model ResearchAnalytics.Models.SearchQuery
@using System.Linq

@{
    ViewData["Title"] = "Researcher Profiles";

    var allResults = new List<ResearchAnalytics.Models.SearchResult>();

    if (Model?.Results != null)
    {
        foreach (var item in Model.Results)
        {
            if (item != null)
            {
                allResults.Add(item);
            }
        }
    }

    var selectedSource = Context.Request.Query["source"].ToString();

    var results = new List<ResearchAnalytics.Models.SearchResult>();

    foreach (var item in allResults)
    {
        if (string.IsNullOrWhiteSpace(selectedSource) || selectedSource == "All")
        {
            results.Add(item);
        }
        else if (!string.IsNullOrWhiteSpace(item.Source) &&
                 item.Source.StartsWith(selectedSource))
        {
            results.Add(item);
        }
    }

    ResearchAnalytics.Models.SearchResult? topResult = null;

    foreach (var item in results)
    {
        if (topResult == null || item.Citations > topResult.Citations)
        {
            topResult = item;
        }
    }
}
<div class="page-shell">

    <div class="ra-card mb-4">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <span class="text-muted text-uppercase small fw-semibold">
                    Research profile matching
                </span>

                <h1 class="page-title mb-2">
                    @Model.QueryText
                </h1>

                <p class="page-subtitle mb-0">
                    Matching researcher profiles found across academic data sources.
                </p>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
        </div>

        <div class="row mt-4">
            <div class="col-md-3 mb-3">
                <div class="mini-stat-card h-100">
                    <span class="mini-stat-label">Profiles found</span>
                    <div class="mini-stat-value">@results.Count</div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="mini-stat-card h-100">
                    <span class="mini-stat-label">Top cited profile</span>
                    <div class="mini-stat-value">@topResult.Citations citations</div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="mini-stat-card h-100">
                    <span class="mini-stat-label">Sources</span>
                    <div class="mini-stat-value">
                        @results.Select(r => r.Source?.StartsWith("OpenAlex") == true ? "OpenAlex" : "Semantic Scholar").Distinct().Count()
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="mini-stat-card h-100">
                    <span class="mini-stat-label">Generated</span>
                    <div class="mini-stat-value small">
                        @Model.CreatedAt.ToLocalTime().ToString("g")
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (results.Any())
    {
        <div class="ra-card mb-4">
            <form method="get">
                <input type="hidden" name="id" value="@Model.SearchQueryId" />

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h4 class="mb-1">Candidate profiles</h4>
                        <p class="text-muted mb-0">
                            Select one or more profiles that belong to the same researcher.
                        </p>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <label class="text-muted small">Source</label>

                        <select name="source"
                                class="form-select search-source-select"
                                onchange="this.form.submit()">
                            <option value="All" selected="@(selectedSource == "" || selectedSource == "All")">
                                All sources
                            </option>
                            <option value="Semantic Scholar" selected="@(selectedSource == "Semantic Scholar")">
                                Semantic Scholar
                            </option>
                            <option value="OpenAlex" selected="@(selectedSource == "OpenAlex")">
                                OpenAlex
                            </option>
                        </select>
                    </div>
                </div>
            </form>
        </div>

        <form asp-action="CombinedReport" method="post">
            <input type="hidden" name="searchQueryId" value="@Model.SearchQueryId" />

            <div class="ra-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h4 class="mb-1">Researcher matches</h4>
                        <span class="text-muted small">
                            Profiles are ranked by citation impact.
                        </span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Generate Report
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 ra-clean-table">
                        <thead>
                            <tr>
                                <th style="width:70px;">Select</th>
                                <th>Author</th>
                                <th style="width:140px;">Papers</th>
                                <th style="width:140px;">Citations</th>
                                <th style="width:220px;">Source</th>
                                <th style="width:180px;">External ID</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var result in results)
                            {
                                var externalId = result.ExternalAuthorId?.Split('/').Last();

                                <tr class="@(result == topResult ? "highlight-row" : "")">
                                    <td>
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedAuthorIds"
                                               value="@result.SearchResultId" />
                                    </td>

                                    <td>
                                        <a asp-action="AuthorDetails"
                                           asp-route-id="@result.SearchResultId"
                                           class="fw-semibold text-decoration-none">
                                            @result.AuthorName
                                        </a>

                                        @if (result == topResult)
                                        {
                                            <span class="badge bg-success ms-2">Top cited</span>
                                        }
                                    </td>

                                    <td>@result.PaperCount</td>
                                    <td>@result.Citations</td>
                                    <td>@result.Source</td>
                                    <td class="text-muted">@externalId</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-info">
            No authors found for this search.
        </div>
    }
</div>