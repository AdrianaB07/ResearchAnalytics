@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="page-title">Admin Dashboard</h1>
            <p class="page-subtitle">
                Monitor platform usage, research searches and stored academic data.
            </p>
        </div>

        <span class="badge bg-light text-dark border px-3 py-2">
            Administrator
        </span>
    </div>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="ra-card h-100">
                <span class="text-muted">Total Users</span>
                <div class="ra-metric">@ViewBag.TotalUsers</div>
                <small class="text-muted">Registered accounts</small>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="ra-card h-100">
                <span class="text-muted">Total Searches</span>
                <div class="ra-metric">@ViewBag.TotalSearches</div>
                <small class="text-muted">Researcher queries</small>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="ra-card h-100">
                <span class="text-muted">Authors Analyzed</span>
                <div class="ra-metric">@ViewBag.TotalAuthors</div>
                <small class="text-muted">Author profiles stored</small>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="ra-card h-100">
                <span class="text-muted">Papers Stored</span>
                <div class="ra-metric">@ViewBag.TotalPapers</div>
                <small class="text-muted">Publications loaded</small>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="ra-card h-100">
                <span class="text-muted">Total Citations</span>
                <div class="ra-metric">@ViewBag.TotalCitations</div>
                <small class="text-muted">Citation impact from stored papers</small>
            </div>
        </div>

        <div class="col-md-8">
            <div class="ra-card h-100">
                <h5 class="mb-2">System Overview</h5>
                <p class="text-muted mb-0">
                    This dashboard provides an administrative overview of the platform,
                    including users, searches, author profiles, stored publications and citation data.
                </p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="ra-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Recent Searches</h4>
                    <span class="text-muted small">Latest activity</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Query</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var search in ViewBag.RecentSearches)
                            {
                                <tr>
                                    <td class="fw-semibold">@search.QueryText</td>
                                    <td class="text-muted">@search.CreatedAt.ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="ra-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Top Searched Queries</h4>
                    <span class="text-muted small">Most frequent</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Query</th>
                                <th style="width: 140px;">Search Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.TopQueries)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.QueryText</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-3 py-2">
                                            @item.Count
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>