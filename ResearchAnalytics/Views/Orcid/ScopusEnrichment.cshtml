@model List<ResearchAnalytics.Models.ScopusEnrichedPaper>

@{
    ViewData["Title"] = "ORCID Scopus Enrichment";
}

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="page-title">ORCID Scopus Enrichment</h1>
            <p class="page-subtitle">
                ORCID works matched against Scopus publication metadata.
            </p>
        </div>

        <a asp-controller="Orcid"
           asp-action="Works"
           asp-route-orcidId="@ViewBag.OrcidId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>

    <div class="ra-card mb-4">
        <div class="row text-center">
            <div class="col-md-3">
                <span class="text-muted">Researcher</span>
                <div class="fw-semibold mt-2">@ViewBag.AuthorName</div>
            </div>

            <div class="col-md-3">
                <span class="text-muted">ORCID works</span>
                <div class="ra-metric">@ViewBag.TotalWorks</div>
            </div>

            <div class="col-md-3">
                <span class="text-muted">Checked</span>
                <div class="ra-metric">@ViewBag.CheckedWorks</div>
            </div>

            <div class="col-md-3">
                <span class="text-muted">Found in Scopus</span>
                <div class="ra-metric">@ViewBag.FoundInScopus</div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="text-muted">
            Checked @ViewBag.CheckedWorks of @ViewBag.TotalWorks ORCID works.
        </div>

        <div class="d-flex gap-2">
            @if (ViewBag.HasMore == true)
            {
                <a asp-controller="Orcid"
                   asp-action="EnrichWorksWithScopus"
                   asp-route-orcidId="@ViewBag.OrcidId"
                   asp-route-limit="@ViewBag.NextLimit"
                   class="btn btn-primary">
                    Search next 5 works
                </a>
            }

            <a asp-controller="Orcid"
               asp-action="ExportOrcidScopusEnrichmentToExcel"
               asp-route-orcidId="@ViewBag.OrcidId"
               asp-route-limit="@ViewBag.CurrentLimit"
               class="btn btn-success">
                Export Excel
            </a>
        </div>
    </div>

    <div class="ra-card">
        <h4 class="mb-3">Scopus enrichment results</h4>

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Original ORCID Title</th>
                        <th>Status</th>
                        <th>Scopus Title</th>
                        <th>Journal</th>
                        <th style="width: 110px;">Year</th>
                        <th style="width: 120px;">Citations</th>
                        <th>DOI</th>
                        <th style="width: 100px;">Link</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.OriginalTitle</td>

                            <td>
                                @if (item.FoundInScopus)
                                {
                                    <span class="badge bg-success">Found</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not found</span>
                                }
                            </td>

                            <td>@(item.ScopusTitle ?? "-")</td>
                            <td>@(item.PublicationName ?? "-")</td>
                            <td>@(item.Year ?? "-")</td>
                            <td>@(item.CitedByCount ?? "-")</td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.DOI))
                                {
                                    <a href="https://doi.org/@item.DOI" target="_blank">
                                        @item.DOI
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Link))
                                {
                                    <a href="@item.Link"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">
                                        Open
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>