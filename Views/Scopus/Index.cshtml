@model List<ResearchAnalytics.Models.ScopusPublication>

@{
    ViewData["Title"] = "Scopus Publication Search";
    var query = ViewBag.Query as string ?? "";
}

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="page-title">Scopus Publication Search</h1>
            <p class="page-subtitle">
                Search Scopus publications by title and review publication-level metadata.
            </p>
        </div>
    </div>

    <div class="ra-card mb-4">
        <form method="post">
            <label class="form-label fw-semibold">Publication title</label>

            <div class="d-flex gap-2">
                <input type="text"
                       name="query"
                       class="form-control search-input"
                       value="@query"
                       placeholder="Enter publication title..." />

                <button type="submit"
                        class="btn btn-primary search-circle-btn"
                        title="Search">
                    <i class="bi bi-search"></i>
                </button>
            </div>

            <div class="form-text mt-2">
                Scopus is used here for publication-level metadata search.
            </div>
        </form>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary()
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="ra-card mb-4">
            <div class="row text-center">
                <div class="col-md-6">
                    <span class="text-muted">Results found</span>
                    <div class="ra-metric">@Model.Count</div>
                </div>

                <div class="col-md-6">
                    <span class="text-muted">Query</span>
                    <div class="fw-semibold mt-2">@query</div>
                </div>
            </div>
        </div>

        <div class="ra-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Publication Results</h4>
                <span class="text-muted small">Source: Scopus</span>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Journal</th>
                            <th style="width: 110px;">Year</th>
                            <th style="width: 100px;">Citations</th>
                            <th>DOI</th>
                            <th style="width: 100px;">Link</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var paper in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@paper.Title</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(paper.Authors))
                                    {
                                        @paper.Authors
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>@paper.PublicationName</td>
                                <td>@paper.Year</td>
                                <td>@paper.CitedByCount</td>
                                <td>@paper.DOI</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(paper.Link))
                                    {
                                        <a href="@paper.Link"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary">
                                            Open
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model != null)
    {
        <div class="alert alert-warning">
            No publications found.
        </div>
    }
</div>