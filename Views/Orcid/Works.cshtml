@model List<ResearchAnalytics.Models.OrcidWork>

@{
    ViewData["Title"] = "ORCID Works";
}

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="page-title">ORCID Works</h1>
            <p class="page-subtitle">
                Public works retrieved from the selected ORCID profile.
            </p>
        </div>

        <a asp-controller="Orcid"
           asp-action="Profile"
           asp-route-orcidId="@ViewBag.OrcidId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>

    <div class="ra-card mb-4">
        <div class="row text-center">
            <div class="col-md-4">
                <span class="text-muted">Researcher</span>
                <div class="fw-semibold mt-2">@ViewBag.AuthorName</div>
            </div>

            <div class="col-md-4">
                <span class="text-muted">ORCID iD</span>
                <div class="fw-semibold mt-2">
                    <a href="@ViewBag.ProfileUrl" target="_blank">@ViewBag.OrcidId</a>
                </div>
            </div>

            <div class="col-md-4">
                <span class="text-muted">Works found</span>
                <div class="ra-metric">@Model.Count</div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-4">
        <a asp-controller="Orcid"
           asp-action="EnrichWorksWithScopus"
           asp-route-orcidId="@ViewBag.OrcidId"
           class="btn btn-primary">
            Enrich with Scopus
        </a>
    </div>

    <div class="ra-card">
        <h4 class="mb-3">Publication list</h4>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th style="width: 120px;">Year</th>
                            <th style="width: 160px;">Type</th>
                            <th style="width: 180px;">DOI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var work in Model.OrderByDescending(w => w.PublicationYear))
                        {
                            <tr>
                                <td class="fw-semibold">@work.Title</td>
                                <td>@work.PublicationYear</td>
                                <td>@work.WorkType</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(work.DOI))
                                    {
                                        <a href="https://doi.org/@work.DOI" target="_blank">@work.DOI</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>                           
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                No public works found for this ORCID profile.
            </div>
        }
    </div>
</div>