@model List<ResearchAnalytics.Models.ScopusEnrichedPaper>

@{
    ViewData["Title"] = "Scopus Enrichment";
}

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="page-title">Scopus Enrichment</h1>
            <p class="page-subtitle">
                Match the selected author's publications against Scopus and review Scopus metadata.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>

    <div class="ra-card mb-4">
        <div class="row text-center">
            <div class="col-md-4">
                <span class="text-muted">Author</span>
                <div class="fw-semibold mt-2">@ViewBag.AuthorName</div>
            </div>

            <div class="col-md-4">
                <span class="text-muted">Checked publications</span>
                <div class="ra-metric">@ViewBag.CheckedPapers</div>
            </div>

            <div class="col-md-4">
                <span class="text-muted">Found in Scopus</span>
                <div class="ra-metric">@ViewBag.FoundInScopus</div>
            </div>
        </div>
    </div>

    <div class="ra-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Enriched publication results</h4>
            <span class="text-muted small">Original source: @ViewBag.Source</span>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Original Title</th>
                        <th>Status</th>
                        <th>Scopus Title</th>
                        <th>Journal</th>
                        <th>Year</th>
                        <th>Citations</th>
                        <th>DOI</th>
                        <th>Link</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.OriginalTitle</td>

                            <td>
                                @if (item.FoundInScopus)
                                {
                                    <span class="badge bg-success">Found</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not found</span>
                                }
                            </td>

                            <td>@(item.ScopusTitle ?? "-")</td>
                            <td>@(item.PublicationName ?? "-")</td>
                            <td>@(item.Year ?? "-")</td>
                            <td>@(item.CitedByCount ?? "-")</td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.DOI))
                                {
                                    <a href="https://doi.org/@item.DOI" target="_blank">
                                        @item.DOI
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Link))
                                {
                                    <a href="@item.Link"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">
                                        Open
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="d-flex justify-content-between align-items-center mt-4">
                <div class="text-muted">
                    Checked @ViewBag.CheckedPapers of @ViewBag.TotalPapers publications.
                </div>

                <div class="d-flex gap-2">
                    @if (ViewBag.HasMore == true)
                    {
                        <a asp-controller="Search"
                           asp-action="EnrichWithScopus"
                           asp-route-id="@ViewBag.SearchResultId"
                           asp-route-limit="@ViewBag.NextLimit"
                           class="btn btn-primary">
                            Search next 25 publications
                        </a>
                    }

                    <a asp-controller="Search"
                       asp-action="ExportScopusEnrichmentToExcel"
                       asp-route-id="@ViewBag.SearchResultId"
                       asp-route-limit="@ViewBag.CurrentLimit"
                       class="btn btn-success">
                        Export Scopus Excel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>