@model ResearchAnalytics.Models.SearchResult
@using System.Linq

@{
    ViewData["Title"] = "Author Details";

    var papers = Model.Papers ?? new List<ResearchAnalytics.Models.ResearchPaper>();

    var papersByYear = papers
        .Where(p => p.Year.HasValue)
        .GroupBy(p => p.Year.Value)
        .OrderByDescending(g => g.Key)
        .ToList();

    var topPaper = papers.OrderByDescending(p => p.CitationCount).FirstOrDefault();
}

<div class="page-shell">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <span class="text-muted text-uppercase small fw-semibold">
                Research profile
            </span>

            <h1 class="page-title mb-1">
                @Model.AuthorName
            </h1>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary">
                    @Model.Source
                </span>

                <span class="text-muted">
                    Publication activity, citation impact and yearly research trends
                </span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Details"
               asp-route-id="@Model.SearchQueryId"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>

            <a asp-action="EnrichWithScopus"
               asp-route-id="@Model.SearchResultId"
               class="btn btn-primary">
                Enrich with Scopus
            </a>
        </div>

    </div>
   
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="ra-card h-100">
                <span class="text-muted">Papers</span>
                <div class="ra-metric">@Model.PaperCount</div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="ra-card h-100">
                <span class="text-muted">Citations</span>
                <div class="ra-metric">@Model.Citations</div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="ra-card h-100">
                <span class="text-muted">Avg. citations</span>
                <div class="ra-metric">@ViewBag.AverageCitations</div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="ra-card h-100">
                <span class="text-muted">Active years</span>
                <div class="ra-metric">@ViewBag.ActiveYears</div>
            </div>
        </div>
    </div>

    @if (papers.Any())
    {
        <div class="ra-card mb-4">
            <div class="row text-center">
                <div class="col-md-4">
                    <span class="text-muted">Loaded papers</span>
                    <div class="fw-semibold fs-4">@papers.Count()</div>
                </div>

                <div class="col-md-4">
                    <span class="text-muted">Std. deviation</span>
                    <div class="fw-semibold fs-4">@ViewBag.StandardDeviation</div>
                </div>

                <div class="col-md-4">
                    <span class="text-muted">Most productive year</span>
                    <div class="fw-semibold fs-4">@ViewBag.MostProductiveYear</div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <div class="ra-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Publication Trend</h4>
                        <span class="text-muted small">Publications per year</span>
                    </div>
                    <div class="chart-box">
                        <canvas id="publicationTrendChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="ra-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Citation Trend</h4>
                        <span class="text-muted small">Citations by publication year</span>
                    </div>
                    <div class="chart-box">
                        <canvas id="citationTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <div class="ra-card momentum-card h-100">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="mb-1">Productivity Trend</h4>
                            <p class="text-muted mb-0">
                                Based on publications per year.
                            </p>
                        </div>

                        <div class="momentum-score">
                            @ViewBag.ProductivityTrendScore
                        </div>
                    </div>

                    @{
                        var productivity = Convert.ToDouble(ViewBag.ProductivityTrendScore);
                        var productivityPercent = Math.Round(productivity * 100);
                    }

                    <div class="progress momentum-progress mb-3">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width: @productivityPercent%">
                        </div>
                    </div>

                    <span class="badge bg-primary px-3 py-2">
                        @ViewBag.ProductivityTrendLabel
                    </span>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="ra-card momentum-card h-100">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="mb-1">Citation Impact Trend</h4>
                            <p class="text-muted mb-0">
                                Based on citations by publication year.
                            </p>
                        </div>

                        <div class="momentum-score">
                            @ViewBag.CitationImpactTrendScore
                        </div>
                    </div>

                    @{
                        var citationImpact = Convert.ToDouble(ViewBag.CitationImpactTrendScore);
                        var citationImpactPercent = Math.Round(citationImpact * 100);
                    }

                    <div class="progress momentum-progress mb-3">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width: @citationImpactPercent%">
                        </div>
                    </div>

                    <span class="badge bg-primary px-3 py-2">
                        @ViewBag.CitationImpactTrendLabel
                    </span>

                    <p class="text-muted small mt-3 mb-0">
                        Recent publications may have low citations because they have not had enough time to accumulate impact.
                    </p>
                </div>
            </div>
        </div>
    }

    @if (topPaper != null)
    {
        <div class="alert alert-success mb-4">
            <strong>Most cited publication:</strong>
            @topPaper.Title
            <span class="ms-2">(@topPaper.CitationCount citations)</span>
        </div>
    }

 
    @if (papers.Any())
    {
        <div class="ra-card mb-4">
            <h4 class="mb-3">Citations by Publication Year</h4>

            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Year</th>
                            <th>Number of Papers</th>
                            <th>Total Citations</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in papersByYear)
                        {
                            <tr>
                                <td class="fw-semibold">@group.Key</td>
                                <td>@group.Count()</td>
                                <td>@group.Sum(p => p.CitationCount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="ra-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Publications</h4>
                <span class="text-muted small">Sorted by citation count</span>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th style="width: 110px;">Year</th>
                            <th style="width: 120px;">Citations</th>
                            <th style="width: 100px;">Link</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var paper in papers.OrderByDescending(p => p.CitationCount))
                        {
                            <tr>
                                <td class="fw-semibold">@paper.Title</td>
                                <td>@(paper.Year?.ToString() ?? "N/A")</td>
                                <td>@paper.CitationCount</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(paper.Url))
                                    {
                                        <a href="@paper.Url"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary">
                                            Open
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    }
    else
    {
        <div class="alert alert-info">
            No papers found for this author.
        </div>
    }
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const years = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartYears));
        const paperCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartPaperCounts));
        const citationCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartCitationCounts));

        new Chart(document.getElementById('publicationTrendChart'), {
            type: 'bar',
            data: {
                labels: years,
                datasets: [{
                    label: 'Publications per year',
                    data: paperCounts
                }]
            }
        });

        new Chart(document.getElementById('citationTrendChart'), {
            type: 'line',
            data: {
                labels: years,
                datasets: [{
                    label: 'Citations by publication year',
                    data: citationCounts,
                    tension: 0.3
                }]
            }
        });
    </script>
}