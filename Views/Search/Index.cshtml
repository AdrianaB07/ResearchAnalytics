@model List<ResearchAnalytics.Models.SearchQuery>

@{
    ViewData["Title"] = "My Searches";
}

<div class="ra-card mb-4">
    <form asp-action="New" method="post">

        <div class="d-flex gap-2 align-items-center">

            <input type="text"
                   name="queryText"
                   class="form-control search-input"
                   placeholder="Enter researcher name, e.g. Andrew Ng"
                   required />

            <button type="submit"
                    class="btn btn-primary search-circle-btn">

                <i class="bi bi-search"></i>

            </button>

        </div>

    </form>
</div>

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="page-title">Searches</h1>
            <p class="page-subtitle">
                Search for a researcher or reopen previous research analysis results.
            </p>
        </div>
    </div>



    @if (Model != null && Model.Any())
    {
        <div class="ra-card mb-4">
            <div class="row text-center">
                <div class="col-md-4">
                    <span class="text-muted">Saved searches</span>
                    <div class="ra-metric">@Model.Count</div>
                </div>

                <div class="col-md-4">
                    <span class="text-muted">Latest search</span>
                    <div class="fw-semibold mt-2">
                        @Model.OrderByDescending(s => s.CreatedAt).First().CreatedAt.ToLocalTime().ToString("g")
                    </div>
                </div>

                <div class="col-md-4">
                    <span class="text-muted">Most recent query</span>
                    <div class="fw-semibold mt-2">
                        @Model.OrderByDescending(s => s.CreatedAt).First().QueryText
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Query</th>
                        <th>Date</th>
                        <th style="width: 160px;" class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(s => s.CreatedAt))
                    {
                        <tr>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.SearchQueryId"
                                   class="search-link">
                                    @item.QueryText
                                </a>
                            </td>

                            <td class="text-muted">
                                @item.CreatedAt.ToLocalTime().ToString("g")
                            </td>

                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-action="Details"
                                       asp-route-id="@item.SearchQueryId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Delete this search and all associated data?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.SearchQueryId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ra-card text-center py-5">
            <h3>No searches yet</h3>
            <p class="text-muted">
                Start by searching for a researcher and analyzing their academic activity.
            </p>
        </div>
    }
</div>